LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Set to 1 to skip real LLM calls and use a deterministic stub extractor
# (useful for testing the scrape -> extract -> store wiring without an API key/cost)
JOBSCOUT_FAKE_LLM=0

# Path to your CV, used when rating jobs. Relative paths are resolved from the
# project root. Defaults to cv.tex - drop your real CV there (it's gitignored).
# CV_PATH=cv.tex
